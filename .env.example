# ── LLM Configuration ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_FLOWS_PER_BATCH=10

# Budget / rate limiting
BUDGET_TOKENS_PER_MINUTE=40000
BUDGET_MAX_LLM_CALLS_PER_MINUTE=20

# ── Agent Mode ──────────────────────────────────────────────────────────────────
# Set to true to run without executing real firewall/SMTP actions
SIMULATION_MODE=true

# ── Metrics ─────────────────────────────────────────────────────────────────────
ENABLE_METRICS=true

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Paths ───────────────────────────────────────────────────────────────────────
DB_PATH=data/memory/incidents.db
DATA_DIR=data
MODEL_DIR=models

# ── Email / Alerting ────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=app-password-here
SMTP_FROM=your@gmail.com
SLACK_WEBHOOK_URL=

# ── Threat Intel APIs (optional — free tiers) ──────────────────────────────────
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=

# ── Caching / Streaming (optional) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── LangSmith tracing (optional) ───────────────────────────────────────────────
LANGSMITH_API_KEY=
